# The JNI of the Java runtime the iOS app embeds (OpenJDK mobile, statically linked into the app: see IOS_RUNTIME.md)
headers = jni.h
package = io.github.kdroidfilter.seforimlibrary.search.jni

---

#include <pthread.h>

// A thread attached by seforim_attach_current_thread is detached when it exits, from this destructor: in plain C, as
// the Kotlin runtime of an exiting thread may already be gone
static pthread_key_t seforim_detach_key;
static int seforim_detach_key_ok = 0;
static pthread_once_t seforim_detach_once = PTHREAD_ONCE_INIT;

static void seforim_detach_current_thread(void *vm) {
    (*(JavaVM *) vm)->DetachCurrentThread((JavaVM *) vm);
}

static void seforim_create_detach_key(void) {
    seforim_detach_key_ok = pthread_key_create(&seforim_detach_key, seforim_detach_current_thread) == 0;
}

// The JNIEnv of the calling thread, attached to vm (as a daemon) if it isn't yet; NULL when it can't be. *detach_after
// is set when the caller must detach the thread itself once done: no thread-exit destructor could be registered
static JNIEnv *seforim_attach_current_thread(JavaVM *vm, int *detach_after) {
    JNIEnv *env = NULL;
    *detach_after = 0;
    jint status = (*vm)->GetEnv(vm, (void **) &env, JNI_VERSION_21);
    if (status == JNI_OK) return env;
    if (status != JNI_EDETACHED) return NULL;
    if ((*vm)->AttachCurrentThreadAsDaemon(vm, (void **) &env, NULL) != JNI_OK) return NULL;
    pthread_once(&seforim_detach_once, seforim_create_detach_key);
    if (!seforim_detach_key_ok || pthread_setspecific(seforim_detach_key, vm) != 0) *detach_after = 1;
    return env;
}
