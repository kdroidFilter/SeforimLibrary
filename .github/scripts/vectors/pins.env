# What the library-vectors build runs, pinned. Sourced by bootstrap_runner.sh and
# build_library_vectors.sh; test_library_vectors_workflow.py checks the shapes.

# otzaria-semantic-search (the sidecar): embed-shard / warehouse-add / assemble / gates /
# release-files. The commit the plugin pins too, so the CLI, planner and validator run one sidecar.
SIDECAR_REPO=Otzaria/otzaria-semantic-search
SIDECAR_REV=3aeb94ef83d80d89f3d54dad3cc34ba5ccee4200

# otzaria_search_engine (the plugin), at a commit that pins SIDECAR_REV:
# export_semantic_plan v2, which writes the plan from a release index through the sidecar's
# writers with the recipe the model's chunking_identity names (so one build plans every family),
# and validate_semantic_vectors, the gates a release passes on its index before it is
# published (G3 coverage, G4 resolution, G6 retrieval)
PLUGIN_REPO=Otzaria/otzaria_search_engine
PLUGIN_REV=4be1999da838060adcdd18864f6e626f91bd6e86

# The families in build order, <sidecar config dir>:<release prefix>[:<codec>], each published as
# <prefix>-<tag>; <codec> is the epoch a new base is assembled in (default: the sidecar's i8-sym-vec).
# The first is the one released applications install, so it is published before a later one runs.
FAMILY_CONFIGS="config/models/meivin-round2-onnx:vectors config/models/meivin-round2-windows-onnx:vectors-windows"
# The families (by release prefix) mode auto also publishes a delta for, as <prefix>-delta-<tag>
DELTA_PREFIXES="vectors-windows"
# The package the passages of every family are embedded with: one warehouse serves them all
PASSAGE_QUANTIZATION=fp32
PASSAGE_PACKAGE_CHECKSUM=4a4a2ae88a86f15ffe6069bfcefc3abd13c207cec5d7aaef52c0c59d752ade46
# The query package the application runs, the family's int8 one: the validator's G6 measures
# retrieval with it (fetched from the same mirror, at the same revision)
QUERY_PACKAGE_CHECKSUM=9e408407922b4aab26dd148cbe4b9a0e573c65591cfc799ba28e991d77d9d065
QUERY_GRAPH=seforim-embed-round2-int8.onnx
MODEL_REPO=otzaria/judaic-semantic-round2-onnx-zayit
# The private mirror at a commit, never a branch: byte-identical to the source repository
# ArieLLL123/judaic-semantic-round2-onnx-zayit at 1ec8dc6 (the family's family_id). Every
# fetch is still held to PASSAGE_PACKAGE_CHECKSUM.
MODEL_REVISION=99b8a61
MODEL_GRAPH=seforim-embed-round2-fp32.onnx

# The worker's Python environment (ROCm wheels come from the runner's wheel cache)
ROCM_WHEELS=/opt/otzaria-cache/wheels/rocm-7.2.1
TORCH_PIN=torch==2.9.1+rocm7.2.1.lw.gitff65f5bc
PY_PINS="numpy==2.5.3 onnx==1.23.1 onnxruntime==1.28.0 tokenizers==0.23.2"

# Embedding: a plan of fewer than CPU_EMBED_MAX texts runs on the CPU, through the sidecar's
# embed-shard in CPU_PROCESSES processes of CPU_THREADS ONNX Runtime threads (the reference: no
# parity certificate); a larger one on the GPU worker, in windows of EMBED_WINDOW records, whose
# certificate needs at least 959 plan texts. Measured on the build machine (i7-14700, 16 threads
# in WSL, 8,000 typical texts): 107 texts/s at 8 processes x 2 threads (46.5 at 1 x 16, 79 at
# 2 x 8, 100 at 4 x 4, 101 at 16 x 1), so the largest CPU plan takes about 8 minutes.
CPU_EMBED_MAX=50000
CPU_PROCESSES=8
CPU_THREADS=2
EMBED_WINDOW=1048576

# The free space a build needs on the state volume
MIN_FREE_GB=40
